class Solution {
public:
    void union_(int x, int y, vector<int> &parent)
    {
        parent[find_(x, parent)] = find_(y, parent);
    }
    
    int find_(int x, vector<int> &parent)
    {
        if(x != parent[x])
            parent[x] = find_(parent[x], parent);
        
        return parent[x];
    }

    string smallestStringWithSwaps(string s, vector<vector<int>>& pairs) {
        vector<int> parent(s.length());
        //map<int, vector<char>> ss;
        vector<multiset<char>> ms(s.length());

        for(int i = 0; i<s.length() ; ++i )
        {
            parent[i] = i;
        }

        for(auto pair : pairs)
        {
            // create union
            union_(pair[0], pair[1], parent);
        }
        
        for(int i = 0; i< s.length(); ++i)
        {
            // divide strings into substrings of connected graph
            ms[find_(i, parent)].insert(s[i]);
        }
        
        for(int i = 0; i< s.length(); ++i)
        {
            // put the chars to back together
            if(ms[parent[i]].size()>0)
            {
                s[i] = *ms[parent[i]].begin();
                ms[parent[i]].erase(ms[parent[i]].begin());
            }
        }
        
        // return the new formed string
        return s;
         
       }
};
